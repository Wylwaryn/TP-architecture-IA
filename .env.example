# Copier en .env puis ajuster si besoin.
# --- Connexions (noms de services docker-compose) ---
OLLAMA_BASE_URL=http://ollama:11434
ES_URL=http://elasticsearch:9200

# --- Modèles Ollama ---
EMBED_MODEL=bge-m3
EMBED_DIM=1024
RERANK_MODEL=qwen3.5:4b

# --- Clustering / recherche ---
N_CLUSTERS=5
N_PROBE=1

# --- Données (chemin DANS le conteneur indexer) ---
DATA_FILE=/data/objet_consultations_1000.txt

# --- Alternative : utiliser l'Ollama NATIF de l'hôte (GPU) au lieu du conteneur ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434
