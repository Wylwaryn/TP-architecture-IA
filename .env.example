# OPTIONNEL : les valeurs par défaut sont déjà dans docker-compose.yml.
# Copier en .env uniquement pour surcharger un paramètre.

OLLAMA_BASE_URL=http://ollama:11434
ELASTICSEARCH_HOST=http://elasticsearch:9200
EMBED_MODEL=bge-m3
EMBED_DIM=1024
RERANK_MODEL=qwen3.5:4b
N_CLUSTERS=5
N_PROBE=1

# Pour utiliser l'Ollama NATIF de l'hôte (GPU) au lieu du conteneur :
# OLLAMA_BASE_URL=http://host.docker.internal:11434
